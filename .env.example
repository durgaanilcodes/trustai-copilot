# Copy this file to .env and edit. NEVER commit .env or real API keys.

# --- Application ---
TRUSTAI_ENV=development
TRUSTAI_LOG_LEVEL=INFO

# --- Storage ---
TRUSTAI_UPLOAD_DIR=data/uploads

# --- Ingestion limits ---
TRUSTAI_MAX_UPLOAD_MB=20
TRUSTAI_MAX_PDF_PAGES=500
# Minimum extracted characters for a document to count as "has text".
# Below this, a PDF is treated as scanned/image-only and rejected (no OCR in Phase 1).
TRUSTAI_MIN_TEXT_CHARS=20

# --- Added in later phases (placeholders, not used yet) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/trustai
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=
